{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: Debug Unittest",
      "type": "debugpy",
      "request": "launch",
      "module": "unittest",
      "cwd": "${workspaceFolder}",
      "args": ["discover", "-s", "src", "-t", "src", "-p", "test_*.py"],
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
